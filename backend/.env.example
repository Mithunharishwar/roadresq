# ─────────────────────────────────────────────────────────────────────────────
# RoadResQ backend configuration
#
# Copy to `.env` and edit. EVERY value here has a safe default in `config.py`,
# so the server also starts with no .env file at all.
#
# Nothing in this file is a placeholder secret — leave the Razorpay values
# blank unless you have real test keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
# Bind address and port of the Flask-SocketIO server.
ROADRESQ_BIND_HOST=0.0.0.0
ROADRESQ_PORT=5050
# Keep this OFF. Flask debug mode exposes the Werkzeug console (remote code
# execution) if the port is reachable on the network.
ROADRESQ_DEBUG=false

# ── Secrets ─────────────────────────────────────────────────────────────────
# Leave blank for development: a random key is generated per boot and tokens
# are then invalidated on restart. SET THIS IN PRODUCTION so tokens survive a
# restart. Generate one with:  python -c "import secrets;print(secrets.token_hex(32))"
ROADRESQ_SECRET_KEY=
ROADRESQ_TOKEN_TTL_SECONDS=604800

# ── Database ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/
ROADRESQ_DB_NAME=roadresq_db
MONGO_TIMEOUT_MS=3000

# ── Development / demo mode ─────────────────────────────────────────────────
# true  -> the fixed development OTP is accepted and returned in API responses
#          under an explicitly-named `devOtp` field, and `/api/mechanic/instant`
#          creates unverified convenience accounts.
# false -> development OTP verification refuses to run; a real SMS provider is
#          required. Turn this OFF before any deployment.
ROADRESQ_DEV_MODE=true
ROADRESQ_DEV_OTP=1234

# ── Allocation engine (§15–§19) ─────────────────────────────────────────────
# In-region search radius, and the wider radius used only when the region
# yields nobody.
ALLOC_SEARCH_RADIUS_KM=10.0
ALLOC_ESCALATION_RADIUS_KM=25.0
# Assumed average travel speed for ETA. This is an ASSUMPTION, not a measured
# value — reported ETAs are estimates.
ALLOC_ASSUMED_SPEED_KMH=30.0
# A mechanic whose last location update is older than this is treated as stale.
ALLOC_LOCATION_STALE_SECONDS=900

# Ranking weights. These are configuration for a transparent scoring function.
# They are NOT scientifically validated and no accuracy is claimed for them.
ALLOC_W_PROXIMITY=0.45
ALLOC_W_SERVICE=0.20
ALLOC_W_AVAILABILITY=0.15
ALLOC_W_VERIFICATION=0.10
ALLOC_W_WORKLOAD=0.05
ALLOC_W_RATING=0.05

# ── Domain ──────────────────────────────────────────────────────────────────
# Reject an identical open request from the same phone within this window.
ROADRESQ_DUPLICATE_WINDOW_SECONDS=120

# ── Pricing (§30) — prototype rate card, not market-verified ────────────────
PRICING_CURRENCY=INR
PRICING_BASE_FEE=199.0
PRICING_PER_KM=12.0
PRICING_TAX_PERCENT=18.0
PRICING_SURCHARGE_FLAT_TYRE=150.0
PRICING_SURCHARGE_BATTERY=200.0
PRICING_SURCHARGE_FUEL=100.0
PRICING_SURCHARGE_ENGINE=300.0
PRICING_SURCHARGE_TOWING=500.0
PRICING_SURCHARGE_GENERAL=100.0

# ── Payments (§29) ──────────────────────────────────────────────────────────
# Leave blank unless you have real Razorpay keys. With blank values the
# backend creates clearly-flagged SIMULATED orders and never marks a request
# as paid on a fake signature.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_TEST_MODE=true

# ── SMS delivery for login codes ────────────────────────────────────────────
# Empty SMS_PROVIDER = no SMS. The API then reports `smsSent: false` and, while
# ROADRESQ_DEV_MODE is on, returns the code in the clearly-named `devOtp` field.
# Pick ONE provider and fill only its block, then restart the backend.

SMS_PROVIDER=
SMS_SENDER_NAME=RoadResQ
SMS_DEFAULT_COUNTRY_CODE=91

# Twilio (international)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# MSG91 (India, DLT-registered OTP template)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Fast2SMS (India)
FAST2SMS_API_KEY=

# ── OTP policy ──────────────────────────────────────────────────────────────
ROADRESQ_OTP_LENGTH=6
ROADRESQ_OTP_TTL_SECONDS=300
ROADRESQ_OTP_MAX_ATTEMPTS=5
ROADRESQ_OTP_RESEND_SECONDS=30
# Rolling one-hour ceiling per phone number, across all four login forms, so a
# single number cannot drive up the SMS bill. 0 disables it (development only).
ROADRESQ_OTP_MAX_PER_HOUR=8
